# Bounded Context Portal — configuration reference. Placeholder values only; never commit real secrets.
# Every *_SECRET / *_KEY variable also accepts a *_FILE variant pointing at a file (Key Vault CSI mounts).

# ---------- shared (api + worker) ----------
BCP_DATABASE_URL=postgres://bcp:bcp@localhost:5432/bcp
BCP_DATABASE_MAX_CONNECTIONS=10
# Browser-facing origin of the portal. Used for OAuth redirect URI, Origin (CSRF) checks and PR links.
BCP_PUBLIC_URL=http://localhost:3000

# GitHub (github.com defaults shown; for GHES use https://ghe.example.com/api/v3 and https://ghe.example.com)
# For standard GitHub OAuth App login (real user, real repos & branches), only BCP_GITHUB_CLIENT_ID and
# BCP_GITHUB_CLIENT_SECRET are required! Leave BCP_GITHUB_APP_ID and BCP_GITHUB_PRIVATE_KEY empty.
BCP_GITHUB_API_URL=https://api.github.com
BCP_GITHUB_WEB_URL=https://github.com
# Server-side base for the OAuth token exchange. Defaults to BCP_GITHUB_WEB_URL (differs only in local mocks).
# BCP_GITHUB_OAUTH_URL=https://github.com
# Leave empty to sign in with a personal access token instead of an OAuth App.
BCP_GITHUB_CLIENT_ID=
BCP_GITHUB_CLIENT_SECRET=
# Optional — only set these if using a full GitHub App instead of a standard OAuth App:
BCP_GITHUB_APP_ID=
BCP_GITHUB_APP_SLUG=bounded-context-portal
# BCP_GITHUB_PRIVATE_KEY_FILE=/mnt/secrets/github-app-private-key
BCP_GITHUB_PRIVATE_KEY=
# 32 random bytes, base64. Generate: openssl rand -base64 32
BCP_TOKEN_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

BCP_AGENT_BUNDLE_DIR=./agent-bundle
BCP_MODELS_FILE=./config/models.yaml
BCP_MODELS_SHOW_UNVERIFIED=false
# Generator registry: curated generator repositories + the allowlist for user-added ones.
BCP_GENERATORS_FILE=./config/generators.yaml
# Models are listed per user from the Copilot API (falls back to the catalog). Set to "off" to use the
# catalog only, or to another base URL to point at a different endpoint.
# BCP_COPILOT_API_URL=https://api.githubcopilot.com
# BCP_COPILOT_INTEGRATION_ID=copilot-developer-cli
# If Docker builds are behind TLS inspection, set this to the base64-encoded PEM corporate root CA.
# Generate with: openssl base64 -A -in corporate-root-ca.pem
# BCP_CA_CERT_BASE64=
# Most repositories one batch request may cover.
# BCP_BATCH_MAX_REPOS=25

BCP_LOG_FORMAT=pretty            # json in clusters
RUST_LOG=info,bcp=debug,sqlx=warn
# OpenTelemetry (optional). Traces are exported only when an endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME=bcp-api

# ---------- api ----------
BCP_API_LISTEN=0.0.0.0:8080
BCP_API_METRICS_LISTEN=0.0.0.0:9090
BCP_SESSION_TTL_HOURS=12
BCP_COOKIE_SECURE=false          # true behind TLS
BCP_RATE_LIMIT_PER_MINUTE=120
BCP_JOB_CREATE_LIMIT_PER_HOUR=20
BCP_RUN_MIGRATIONS=true          # clusters run `bcp-api migrate` as a Helm hook instead
BCP_JOB_RETENTION_DAYS=90        # settled jobs (artifacts, logs) older than this are deleted; 0 = keep

# ---------- worker ----------
BCP_WORKER_LISTEN=0.0.0.0:8081
BCP_WORKER_METRICS_LISTEN=0.0.0.0:9091
BCP_WORKER_MODE=loop             # loop (Deployment) | once (KEDA ScaledJob: one task then exit)
BCP_WORKER_CONCURRENCY=1
# BCP_WORKER_ID=defaults-to-hostname
BCP_WORK_DIR=/tmp/bcp-work
BCP_COPILOT_BIN=copilot          # path to GitHub Copilot CLI (tools/fake-copilot for tests)
# Each job runs Copilot with the requester's sign-in token (billed to their own Copilot credits). Users must sign
# in with a fine-grained PAT (github_pat_) that has the "Copilot Requests" permission; Copilot rejects classic ghp_.
# Setting this instead bills EVERY job to one shared account.
# BCP_COPILOT_GITHUB_TOKEN=github_pat_...
BCP_MAX_JOB_TIMEOUT_SECS=18000   # hard cap (5 hours); the bundle's runtime.timeout_secs applies below this
BCP_CENTRAL_REPO=ATT-DP1/apm0014313-ragaflow-ai-context-docs
BCP_MAX_REPO_BYTES=524288000     # extracted snapshot size cap (500 MiB)
BCP_MAX_REPO_FILES=100000
BCP_TASK_LEASE_SECS=60
BCP_GENERATE_MAX_ATTEMPTS=2
BCP_PUBLISH_MAX_ATTEMPTS=5
BCP_SHUTDOWN_GRACE_SECS=60
BCP_IDLE_EXIT_SECS=30            # once-mode only
BCP_MAX_LOG_LINES=5000           # stored log lines per job

# ---------- local development with the mock GitHub (docker compose) ----------
# MOCK_GITHUB_LISTEN=0.0.0.0:9000
# MOCK_GITHUB_PUBLIC_URL=http://localhost:9000
# For TLS-inspected Docker builds, scripts/start.sh mounts this PEM CA bundle only during the worker build.
# BCP_CA_CERT_FILE=/c/path/to/corporate-root-ca.pem
